worker_processes auto;
pid /tmp/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  sendfile on;
  tcp_nopush on;
  keepalive_timeout 65;
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types application/javascript application/json image/svg+xml text/css text/plain;

  # Render terminates public TLS before forwarding to this container. Preserve
  # its original scheme header and fall back to the local Nginx scheme in tests.
  map $http_x_forwarded_proto $client_forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
  }

  client_body_temp_path /tmp/client_temp;
  proxy_temp_path /tmp/proxy_temp;
  fastcgi_temp_path /tmp/fastcgi_temp;
  uwsgi_temp_path /tmp/uwsgi_temp;
  scgi_temp_path /tmp/scgi_temp;

  log_format json escape=json '{"timestamp":"$time_iso8601","service":"vip-web",'
    '"remote_addr":"$remote_addr","request":"$request","status":$status,'
    '"bytes":$body_bytes_sent,"duration":$request_time,"request_id":"$request_id"}';
  access_log /dev/stdout json;
  error_log /dev/stderr warn;

  server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 100m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' __API_ORIGIN__; manifest-src 'self'; upgrade-insecure-requests" always;

    location = /healthz {
      access_log off;
      default_type text/plain;
      return 200 "ok\n";
    }

    # The public demo must keep authentication and the readable CSRF cookie on
    # one browser origin. Render serves this proxy; Railway remains the API
    # runtime. Do not expose docs, metrics, or arbitrary backend paths here.
    location /auth/ {
      proxy_pass __API_ORIGIN__;
      proxy_http_version 1.1;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $client_forwarded_proto;
      proxy_read_timeout 120s;
    }

    location /api/ {
      proxy_pass __API_ORIGIN__;
      proxy_http_version 1.1;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $client_forwarded_proto;
      proxy_buffering off;
      proxy_read_timeout 900s;
    }

    location = /health {
      proxy_pass __API_ORIGIN__/health;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $client_forwarded_proto;
    }

    location = /ready {
      proxy_pass __API_ORIGIN__/ready;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto $client_forwarded_proto;
    }

    location ~* \.(?:css|js|svg|png|jpg|jpeg|woff2?)$ {
      expires 1y;
      add_header Cache-Control "public, immutable";
      try_files $uri =404;
    }

    location / {
      add_header Cache-Control "no-store";
      try_files $uri $uri/ /index.html;
    }
  }
}
