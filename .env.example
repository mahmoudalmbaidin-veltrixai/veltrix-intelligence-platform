# Veltrix Intelligence Platform environment template
#
# Copy this file to .env for Docker Compose. For native API development, copy
# apps/api/.env.example to apps/api/.env. Values prefixed with VITE_ are embedded
# in the browser bundle and must never contain secrets.

# APPLICATION
APP_NAME=VIP API
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
SERVICE_NAME=vip-api
ENABLE_DOCS=true
API_V1_PREFIX=/api/v1
BUILD_COMMIT_SHA=
BUILD_TIMESTAMP=

# Incomplete AI surfaces remain disabled in V1. Mock mode is development-only.
AI_CAPABILITIES_PRODUCTION_READY=false
AI_DEVELOPMENT_MOCK_MODE=false

# DATABASE
# Docker Compose uses POSTGRES_*; DATABASE_URL is required for native API processes.
POSTGRES_DB=vip
POSTGRES_USER=vip
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vip:replace-with-local-development-password@localhost:5432/vip
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=5
DATABASE_ECHO=false

# REDIS
# Local Compose does not enable Redis authentication and must not be used as a production template.
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_SOCKET_TIMEOUT=5

# AUTHENTICATION
AUTH_ACCESS_SESSION_TTL_MINUTES=15
AUTH_REFRESH_SESSION_TTL_DAYS=14
AUTH_SESSION_IDLE_TTL_MINUTES=30
AUTH_SESSION_IDLE_WARNING_MINUTES=5
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=10
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=vip_access_session
AUTH_REFRESH_COOKIE_NAME=vip_refresh_session
AUTH_CSRF_COOKIE_NAME=vip_csrf_token
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=256
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5

# TENANCY AND GOVERNANCE
TENANCY_ORGANIZATION_HEADER=X-Organization-ID
TENANCY_WORKSPACE_HEADER=X-Workspace-ID
TENANCY_REQUIRE_WORKSPACE_BY_DEFAULT=false
TENANCY_DEFAULT_WORKSPACE_NAME=Default
TENANCY_AUDIT_ENABLED=true
TENANCY_CACHE_PREFIX=vip
INVITATION_TOKEN_TTL_HOURS=72
INVITATION_TOKEN_BYTES=32
INVITATION_ACCEPT_URL=http://localhost:3009/invitations/accept
AUTHORIZATION_CACHE_ENABLED=false
AUTHORIZATION_CACHE_TTL_SECONDS=60
FEATURE_FLAGS_CACHE_TTL_SECONDS=60
ENTITLEMENTS_CACHE_TTL_SECONDS=60
QUOTA_CACHE_TTL_SECONDS=30
AUDIT_EVENTS_ENABLED=true
AUDIT_DENIED_ACCESS=true
AUDIT_RETENTION_DAYS=365
GOVERNANCE_FAIL_CLOSED=true

# CONNECTION SECURITY AND DATA QUERY LIMITS
# Generate a unique URL-safe base64 key for each non-development environment.
CONNECTION_SECRET_PROVIDER=database_encrypted
CONNECTION_ENCRYPTION_KEY=
CONNECTION_ENCRYPTION_KEY_VERSION=v1
CONNECTION_TEST_TIMEOUT_SECONDS=15
CONNECTION_TEST_MAX_REDIRECTS=2
CONNECTION_TEST_RATE_LIMIT_PER_MINUTE=10
CONNECTION_ALLOW_PRIVATE_NETWORKS=false
CONNECTION_ALLOW_HTTP=false
CONNECTION_BLOCK_CLOUD_METADATA=true
CONNECTION_MAX_CONFIGURATION_BYTES=32768
CONNECTION_MAX_SECRET_BYTES=16384
METADATA_DISCOVERY_TIMEOUT_SECONDS=30
METADATA_DISCOVERY_MAX_OBJECTS=500
METADATA_DISCOVERY_MAX_FIELDS_PER_OBJECT=500
LINEAGE_MAX_DEPTH=5
LINEAGE_MAX_NODES=250
SEMANTIC_QUERY_DEFAULT_LIMIT=100
SEMANTIC_QUERY_MAX_LIMIT=1000
SEMANTIC_QUERY_MAX_OFFSET=10000
SEMANTIC_QUERY_MAX_DIMENSIONS=10
SEMANTIC_QUERY_MAX_METRICS=20
SEMANTIC_QUERY_MAX_FILTERS=25
SEMANTIC_QUERY_MAX_ORDER_FIELDS=10
SEMANTIC_QUERY_MAX_IN_VALUES=500
SEMANTIC_QUERY_TIMEOUT_SECONDS=30
SEMANTIC_QUERY_MAX_RESULT_BYTES=5242880

# DASHBOARDS, EXPORTS, AND DELIVERY
DASHBOARD_MAX_PAGES=50
DASHBOARD_MAX_WIDGETS=250
DASHBOARD_MAX_WIDGETS_PER_PAGE=100
DASHBOARD_MAX_FILTERS=50
DASHBOARD_MAX_EDITOR_PAYLOAD_BYTES=2097152
DASHBOARD_MAX_VERSION_SNAPSHOT_BYTES=5242880
DASHBOARD_QUERY_MAX_CONCURRENT_WIDGETS=8
DASHBOARD_QUERY_TIMEOUT_SECONDS=30
DASHBOARD_QUERY_CACHE_ENABLED=false
DASHBOARD_QUERY_CACHE_TTL_SECONDS=60
DASHBOARD_QUERY_MAX_RESULT_BYTES=5242880
DASHBOARD_SNAPSHOT_MAX_BYTES=20971520
DASHBOARD_SNAPSHOT_RETENTION_DAYS=30
DASHBOARD_EXPORT_MAX_ATTEMPTS=3
DASHBOARD_EXPORT_MAX_ARTIFACT_BYTES=52428800
DASHBOARD_EXPORT_RETENTION_HOURS=24
DASHBOARD_EXPORT_WORKER_POLL_SECONDS=1
DASHBOARD_EXPORT_LEASE_SECONDS=120
DASHBOARD_ARTIFACT_ROOT=/data/vip-artifacts
DASHBOARD_DOWNLOAD_TOKEN_TTL_SECONDS=300
DASHBOARD_DOWNLOAD_SIGNING_KEY=
DASHBOARD_DELIVERY_SCHEDULER_ENABLED=true
DASHBOARD_DELIVERY_SCHEDULER_POLL_SECONDS=15
DASHBOARD_DELIVERY_SCHEDULER_BATCH=25

# EMAIL
# disabled and file are local/development modes. Production validation requires smtp.
DASHBOARD_EMAIL_PROVIDER=disabled
DASHBOARD_EMAIL_OUTBOX_ROOT=/data/vip-email-outbox
DASHBOARD_EMAIL_FROM=no-reply@example.com
DASHBOARD_SMTP_HOST=
DASHBOARD_SMTP_PORT=587
DASHBOARD_SMTP_USERNAME=
DASHBOARD_SMTP_PASSWORD=
DASHBOARD_SMTP_STARTTLS=true
DASHBOARD_SMTP_USE_TLS=false
DASHBOARD_SMTP_TIMEOUT_SECONDS=30

# PIPELINES
PIPELINE_MAX_NODES=250
PIPELINE_MAX_EDGES=1000
PIPELINE_RUN_MAX_ATTEMPTS=3
PIPELINE_RUN_MAX_ROWS=100000
PIPELINE_RUN_MAX_RESULT_BYTES=52428800
PIPELINE_RUN_TIMEOUT_SECONDS=900
PIPELINE_WORKER_POLL_SECONDS=1
PIPELINE_WORKER_LEASE_SECONDS=120
PIPELINE_ARTIFACT_ROOT=/data/vip-pipeline-artifacts
PIPELINE_ARTIFACT_RETENTION_HOURS=24
PIPELINE_DOWNLOAD_TOKEN_TTL_SECONDS=300
PIPELINE_DOWNLOAD_SIGNING_KEY=
PIPELINE_SCHEDULER_ENABLED=true
PIPELINE_SCHEDULER_POLL_SECONDS=15
PIPELINE_SCHEDULER_BATCH=25

# WORKERS AND EVENTS
JOB_QUEUE_PREFIX=vip:jobs
JOB_DEFAULT_QUEUE=default
JOB_WORKER_QUEUES=default,dashboard
JOB_WORKER_CONCURRENCY=4
JOB_WORKER_POLL_SECONDS=1
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=15
JOB_DEFAULT_TIMEOUT_SECONDS=900
JOB_MAX_PAYLOAD_BYTES=1048576
JOB_MAX_RESULT_BYTES=10485760
JOB_EVENT_STREAM_MAXLEN=10000
JOB_EVENT_HEARTBEAT_SECONDS=15
EVENTS_SUBSCRIPTION_RATE_LIMIT_PER_MINUTE=30

# STORAGE AND MALWARE SCANNING
# V1 ships a local-filesystem provider. Production needs a shared persistent volume.
FILE_STORAGE_PROVIDER=local
FILE_STORAGE_ROOT=/data/vip-files
FILE_MAX_UPLOAD_BYTES=104857600
FILE_ALLOWED_MIME_TYPES=application/json,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/png,image/jpeg,text/csv,text/plain
FILE_ALLOWED_EXTENSIONS=.csv,.json,.pdf,.png,.jpg,.jpeg,.txt,.xlsx
FILE_DOWNLOAD_TOKEN_TTL_SECONDS=300
FILE_DOWNLOAD_SIGNING_KEY=
FILE_STREAM_CHUNK_BYTES=1048576
FILE_RETENTION_DAYS=365
FILE_MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
FILE_SCAN_TIMEOUT_SECONDS=30
DEFENDER_COMMAND=MpCmdRun.exe
FILE_UPLOAD_RATE_LIMIT_PER_MINUTE=30
FILE_DOWNLOAD_RATE_LIMIT_PER_MINUTE=120

# METRICS AND MONITORING
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=

# FRONTEND AND CORS
FRONTEND_URL=http://localhost:3009
CORS_ALLOWED_ORIGINS=http://localhost:3009
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=http://localhost:3009
TRUSTED_HOSTS=localhost,127.0.0.1,api
VITE_APP_ENV=development
VITE_API_MODE=live
VITE_API_BASE_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=15000
VITE_AUTH_CSRF_COOKIE_NAME=vip_csrf_token
VITE_AUTH_CSRF_HEADER_NAME=X-CSRF-Token
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_MOCK_LATENCY=false

# LOCAL PORTS
API_PORT=8000

# OPTIONAL CONNECTOR DEVELOPMENT PROFILE
MYSQL_DATABASE=vip_connector
MYSQL_USER=vip_connector
MYSQL_PASSWORD=replace-with-local-development-password
MYSQL_ROOT_PASSWORD=replace-with-local-development-root-password
MYSQL_PORT=3306

# TESTING AND DEMO DEVELOPMENT
# These values are local fixtures only. Never place reusable user credentials here.
RUN_INTEGRATION_TESTS=0
TEST_DATABASE_URL=
PLAYWRIGHT_BASE_URL=http://localhost:3009
PLAYWRIGHT_REUSE_SERVER=1
ALLOW_DEMO_RESET=false
B5_DEMO_POSTGRES_HOST=postgres
B5_DEMO_POSTGRES_DATABASE=vip
B5_DEMO_POSTGRES_USERNAME=vip
B5_DEMO_POSTGRES_PASSWORD=
B5_DEMO_ORGANIZATION_SLUG=
B5_DEMO_WORKSPACE_SLUG=
