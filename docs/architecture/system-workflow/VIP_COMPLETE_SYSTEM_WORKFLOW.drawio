        <mxCell id="title" value="Final Findings and Gaps" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#172554;fontColor=#FFFFFF;fontSize=24;fontStyle=1;align=left;spacingLeft=24;" vertex="1" parent="1">
          <mxGeometry x="20" y="18" width="1880" height="54" as="geometry" />
        </mxCell>
        <mxCell id="purpose" value="Repository comparison, risk summary and implementation priorities." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#C7D2FE;fontColor=#172033;fontSize=11;align=left;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="75" width="1880" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c0" value="Implemented / validated frontend&#xa;&#xa;- Permission-, entitlement- and feature-aware routes&#xa;- Organization/workspace switching and scoped mock persistence&#xa;- Dashboard and Pipeline Studio authoring&#xa;- Normalized errors with correlation IDs&#xa;- Unit, contract, Playwright and accessibility suites&#xa;- Frontend CI quality gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=13;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="430" height="650" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Partial / mock-backed&#xa;&#xa;- Connection, dataset, semantic, report, AI, automation, operations, admin and billing screens&#xa;- Typed service interfaces and many live REST adapter paths&#xa;- Audit, notification, usage and delivery presentation&#xa;- Publish/save lifecycles with local persistence&#xa;- Tenant context headers and session hydration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=3;fontSize=13;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="510" y="150" width="430" height="650" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Critical production gaps&#xa;&#xa;- No backend repository or proven FastAPI services&#xa;- No secure secret vault / connector execution&#xa;- No distributed queue, worker, scheduler or DLQ&#xa;- No server rendering, object storage or email delivery&#xa;- No authoritative billing/quota enforcement&#xa;- No production AI guardrail, tool sandbox or model gateway&#xa;- No deployed observability, migrations or rollout workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=3;fontSize=13;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="980" y="150" width="430" height="650" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Clarifications required&#xa;&#xa;- Authoritative backend language/service boundaries&#xa;- Identity provider, MFA/SSO and session policy&#xa;- Queue / worker / storage technology choices&#xa;- Billing provider and commercial state machine&#xa;- Retention, deletion, legal hold and regional residency&#xa;- AI provider, model policy, trace retention and cost allocation&#xa;- RPO/RTO, SLOs and approval ownership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;dashed=1;fontSize=13;align=left;verticalAlign=top;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="1450" y="150" width="430" height="650" as="geometry" />
        </mxCell>
        <mxCell id="priority" value="PRIORITY SEQUENCE: 1) Identity + tenant authorization contract   2) Data connections + vault + ingestion   3) Queue/workers + pipeline execution   4) Dataset/semantic query service   5) Rendering/email/scheduler   6) AI governance + model gateway   7) Billing enforcement + observability + production deployment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172554;strokeColor=#172554;fontColor=#FFFFFF;fontSize=14;fontStyle=1;spacing=18;" vertex="1" parent="1">
          <mxGeometry x="100" y="850" width="1720" height="100" as="geometry" />
        </mxCell>
        <mxCell id="validation" value="Validation scope: XML structure checked, page inventory checked, PDF parsed and raster-rendered, visual montage inspected. See VIP_WORKFLOW_VALIDATION_REPORT.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="980" width="1320" height="55" as="geometry" />
